{
  "rules": {
    ".read": false,
    ".write": false,
    "pods": {
      ".read": true,
      "$pod": {
        ".write": "auth != null && auth.uid === 'PASTE_SENSOR_ACCOUNT_UID_HERE'",
        "readings": {
          "$id": {
            ".validate": "newData.hasChildren(['t', 'ppb', 'temp']) && newData.child('t').isNumber() && newData.child('ppb').isNumber() && newData.child('temp').isNumber()"
          }
        }
      }
    }
  }
}
